# ==============================================================================
# FIELD WORKFORCE & OPERATIONS MANAGEMENT PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================

# Web Application (Next.js)
NEXT_PUBLIC_APP_NAME="Field Workforce Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DIRECTUS_URL="http://localhost:8055"

# Directus Server Configuration
PORT=8055
PUBLIC_URL="http://localhost:8055"

# Directus Security Keys (Generate strong values in production)
SECRET="change-this-secret-in-production-min-32-chars"
KEY="change-this-key-in-production-min-32-chars"

# Database Connection (PostgreSQL)
DB_CLIENT="pg"
DB_HOST="localhost"
DB_PORT=5432
DB_DATABASE="field_platform"
DB_USER="directus"
DB_PASSWORD="directus_dev_password"

# Initial Admin User Setup (Directus Bootstrap)
ADMIN_EMAIL="admin@fieldplatform.internal"
ADMIN_PASSWORD="AdminPassword123!"

# Storage Configuration (S3-Compatible / Cloudflare R2 / AWS S3)
STORAGE_LOCATIONS="s3"
STORAGE_S3_DRIVER="s3"
STORAGE_S3_KEY="your-s3-access-key-id"
STORAGE_S3_SECRET="your-s3-secret-access-key"
STORAGE_S3_BUCKET="field-platform-media"
STORAGE_S3_REGION="auto" # e.g., us-east-1 or auto for Cloudflare R2
STORAGE_S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_S3_FORCE_PATH_STYLE="false"

# Optional Redis Cache / Queue (Not enabled initially)
REDIS_URL="redis://localhost:6379"
