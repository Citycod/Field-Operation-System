# ==============================================================================
# FIELD WORKFORCE & OPERATIONS MANAGEMENT PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================

# Web Application (Next.js)
NEXT_PUBLIC_APP_NAME="Field Workforce Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Client Access (Browser Safe)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Server Administrative Access (SERVER ONLY - NEVER EXPOSE IN BROWSER)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Optional Supabase CLI Connection Variables
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_DB_PASSWORD="your-db-password"

# Optional Redis Cache / Queue (Not required in initial setup)
REDIS_URL="redis://localhost:6379"
