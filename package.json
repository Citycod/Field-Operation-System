{
  "name": "field-workforce-platform-monorepo",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" --filter \"./packages/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:directus": "docker-compose -f infra/docker/docker-compose.yml up",
    "build": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
