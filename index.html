<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Field Workforce & Operations Management Platform</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --g6: #059669;
            --g7: #047857;
            --g8: #065f46;
            --g9: #064e3b;
            --g4: #34d399;
            --gf: #08783e;
            --ink: #13213c;
            --s9: #020617;
            --pg: #f4f7f8;
            --card: #fff;
            --tx: #13213c;
            --mu: #5f6f86;
            --ln: #d7e0e8;
            --m1: #ecfdf5;
            --m2: #d1fae5;
            --f: 'Montserrat', 'Segoe UI', system-ui, sans-serif;
            box-sizing: border-box;
            padding-top: env(safe-area-inset-top, 0px);
            padding-bottom: env(safe-area-inset-bottom, 0px)
        }

        @media (prefers-color-scheme:dark) {
            :root:not([data-theme="light"]) {
                --pg: #090d16;
                --card: #10182a;
                --tx: #f1f5f9;
                --mu: #9aa9bd;
                --ln: #1e2a40;
                --m1: #08241d;
                --m2: #0b3a2d
            }
        }

        :root[data-theme="dark"] {
            --pg: #090d16;
            --card: #10182a;
            --tx: #f1f5f9;
            --mu: #9aa9bd;
            --ln: #1e2a40;
            --m1: #08241d;
            --m2: #0b3a2d
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 90px
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: var(--pg);
            color: var(--tx);
            font: 500 16px/1.7 var(--f);
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden
        }

        h1,
        h2,
        h3 {
            margin: 0;
            line-height: 1.15;
            font-weight: 600;
            letter-spacing: -.01em
        }

        h2 {
            font-size: clamp(1.9rem, 4vw, 2.9rem)
        }

        p {
            margin: 0
        }

        a {
            color: inherit
        }

        .w {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px
        }

        section {
            padding: 96px 0;
            position: relative
        }

        .ctr {
            text-align: center
        }

        .ctr h2 {
            max-width: 22ch;
            margin: 0 auto
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            padding: 6px 6px 6px 22px;
            border-radius: 12px;
            background: var(--g6);
            color: #fff;
            font: 600 .82rem var(--f);
            text-transform: uppercase;
            letter-spacing: .03em;
            text-decoration: none;
            border: 0;
            cursor: pointer;
            transition: transform .2s, box-shadow .2s
        }

        .btn i {
            display: grid;
            place-items: center;
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: var(--s9);
            color: var(--g4);
            font-style: normal;
            transition: transform .25s
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px -10px var(--g6)
        }

        .btn:hover i {
            transform: rotate(45deg)
        }

        .btn.d {
            background: var(--s9)
        }

        .btn.d i {
            background: var(--g6);
            color: #fff
        }

        .btn:focus-visible,
        a:focus-visible,
        button:focus-visible,
        input:focus-visible,
        select:focus-visible,
        textarea:focus-visible {
            outline: 3px solid #168650;
            outline-offset: 3px
        }

        .bdg {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--card);
            color: var(--g7);
            font-size: 12px;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 8px;
            margin-bottom: 18px;
            border: 1px solid var(--m2)
        }

        .bdg:before,
        .bdg:after {
            content: "";
            width: 12px;
            height: 6px;
            border-radius: 3px;
            background: radial-gradient(circle at 9px 3px, var(--g6) 2.6px, transparent 3px), linear-gradient(var(--g6), var(--g6)) 0 2.5px/7px 1px no-repeat
        }

        .bdg:before {
            transform: scaleX(-1)
        }

        .dk .bdg {
            background: rgba(255, 255, 255, .08);
            color: #a7f3d0;
            border-color: rgba(255, 255, 255, .18)
        }

        .cv3 {
            width: 100%;
            height: 430px;
            display: block
        }

        .rise>* {
            opacity: 0;
            transform: translateY(26px);
            animation: ri .9s cubic-bezier(.2, .7, .2, 1) forwards
        }

        .rise>*:nth-child(2) {
            animation-delay: .12s
        }

        .rise>*:nth-child(3) {
            animation-delay: .24s
        }

        .rise>*:nth-child(4) {
            animation-delay: .36s
        }

        @keyframes ri {
            to {
                opacity: 1;
                transform: none
            }
        }

        .cg {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            margin-top: 54px;
            text-align: left
        }

        .cd {
            display: flex;
            gap: 20px;
            align-items: center;
            padding: 20px 24px;
            background: var(--card);
            border-radius: 18px;
            border: 1px solid var(--ln);
            transition: transform .25s, border-color .25s, box-shadow .25s
        }

        .cd:hover {
            transform: translateY(-4px);
            border-color: var(--g4);
            box-shadow: 0 20px 40px -26px var(--g6)
        }

        .cd:last-child {
            grid-column: span 2
        }

        .cd .ic {
            flex: none;
            width: 68px;
            height: 68px;
            border-radius: 18px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, var(--m2), #a7f3d0)
        }

        .cd svg {
            width: 32px;
            height: 32px;
            stroke: var(--g8);
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round
        }

        .cd h3 {
            font-size: 1.1rem
        }

        .cd p {
            color: var(--mu);
            font-size: .9rem;
            line-height: 1.55;
            margin-top: 4px
        }

        @media(max-width:800px) {
            .cg {
                grid-template-columns: 1fr
            }

            .cd:last-child {
                grid-column: auto
            }
        }

        .tb {
            display: inline-flex;
            gap: 6px;
            padding: 6px;
            background: var(--card);
            border: 1px solid var(--ln);
            border-radius: 14px;
            margin: 0 0 34px
        }

        .tb button {
            font: 600 .8rem var(--f);
            text-transform: uppercase;
            letter-spacing: .03em;
            padding: 13px 26px;
            border: 0;
            border-radius: 10px;
            background: none;
            color: var(--mu);
            cursor: pointer
        }

        .tb button[aria-selected=true] {
            background: var(--g6);
            color: #fff
        }

        .ab {
            display: grid;
            grid-template-columns: 1.1fr .9fr;
            gap: 60px;
            align-items: center
        }

        .pn {
            display: none
        }

        .pn.on {
            display: block;
            animation: ri .6s both
        }

        .pn p {
            color: var(--mu);
            margin: 16px 0 24px
        }

        .ck {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 28px;
            padding-top: 24px;
            border-top: 1px solid var(--ln);
            margin: 0;
            list-style: none;
            padding-left: 0
        }

        .ck li {
            padding-left: 34px;
            position: relative;
            font-weight: 600;
            font-size: .95rem;
            line-height: 1.45
        }

        .ck small {
            display: block;
            color: var(--mu);
            font-weight: 500;
            font-size: .82rem;
            margin-top: 2px
        }

        .ck li:before {
            content: "✓";
            position: absolute;
            left: 0;
            top: 0;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--m2);
            color: var(--g7);
            display: grid;
            place-items: center;
            font-size: .72rem
        }

        @media(max-width:900px) {
            .ab {
                grid-template-columns: 1fr
            }

            .ck {
                grid-template-columns: 1fr
            }
        }

        .dk {
            background: linear-gradient(160deg, var(--s9), var(--g9));
            color: #fff;
            overflow: hidden
        }

        .dk:before {
            content: "";
            position: absolute;
            right: -200px;
            top: -200px;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(16, 185, 129, .35), transparent 65%)
        }

        .dk .w {
            position: relative
        }

        .st {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 22px;
            margin-top: 60px;
            position: relative;
            text-align: left
        }

        .st:before {
            content: "";
            position: absolute;
            left: 8%;
            right: 8%;
            top: 26px;
            border-top: 2px dashed rgba(167, 243, 208, .35)
        }

        .sc {
            position: relative;
            padding: 0 6px
        }

        .sc b {
            display: grid;
            place-items: center;
            width: 54px;
            height: 54px;
            border-radius: 50%;
            background: var(--g6);
            margin-bottom: 22px;
            font-size: 1.1rem;
            box-shadow: 0 0 0 8px rgba(16, 185, 129, .18);
            position: relative
        }

        .sc p {
            color: #b6cfc6;
            margin-top: 8px;
            font-size: .95rem
        }

        @media(max-width:900px) {
            .st {
                grid-template-columns: 1fr 1fr
            }

            .st:before {
                display: none
            }
        }

        @media(max-width:520px) {
            .st {
                grid-template-columns: 1fr
            }
        }

        .pg {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin: 54px 0 40px
        }

        .pt {
            padding: 26px 16px;
            background: var(--card);
            border-radius: 16px;
            border: 1px solid var(--ln);
            font-weight: 600;
            font-size: .95rem;
            line-height: 1.4;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            transition: transform .25s, border-color .25s
        }

        .pt:hover {
            transform: translateY(-5px);
            border-color: var(--g6)
        }

        .pt i {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: var(--g6);
            display: grid;
            place-items: center;
            color: #fff;
            font-style: normal
        }

        .pt:nth-child(3n+2) i {
            background: var(--gf)
        }

        .pt:nth-child(3n) i {
            background: var(--g9)
        }

        .pg .pt:last-child {
            grid-column: 2/4
        }

        @media(max-width:900px) {
            .pg {
                grid-template-columns: 1fr 1fr
            }

            .pg .pt:last-child {
                grid-column: 1/-1
            }
        }

        .cta {
            display: grid;
            grid-template-columns: 1.2fr .8fr;
            gap: 50px;
            align-items: center
        }

        .cta p {
            color: #b6cfc6;
            margin-top: 16px
        }

        .cta .hb {
            margin-top: 32px
        }

        .tbx {
            width: 100%;
            max-width: 400px;
            justify-self: center;
            border-radius: 40px;
            background: linear-gradient(145deg, #10b981, #065f46);
            overflow: hidden;
            box-shadow: 0 30px 60px -30px #000
        }

        .tbx .cv3 {
            height: 340px
        }

        @media(max-width:860px) {
            .cta {
                grid-template-columns: 1fr
            }
        }

        .ct {
            background: var(--card)
        }

        .fm {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px 28px;
            margin-top: 50px;
            text-align: left
        }

        .fm label {
            display: block
        }

        .fm span {
            font-size: .8rem;
            color: var(--mu)
        }

        .fm input,
        .fm select,
        .fm textarea {
            width: 100%;
            border: 0;
            border-bottom: 1.5px solid var(--ln);
            background: none;
            color: var(--tx);
            font: 500 .95rem var(--f);
            padding: 10px 0;
            border-radius: 0
        }

        .fm input:focus,
        .fm select:focus,
        .fm textarea:focus {
            outline: none;
            border-color: var(--g6)
        }

        .fm option {
            color: #13213c
        }

        .fm .full {
            grid-column: 1/-1
        }

        .fm textarea {
            min-height: 110px;
            resize: vertical
        }

        .fb {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            grid-column: 1/-1;
            font-size: .85rem;
            color: var(--mu)
        }

        #ok {
            display: none;
            grid-column: 1/-1;
            padding: 16px 20px;
            border-radius: 12px;
            background: var(--m2);
            color: var(--g8);
            font-weight: 600
        }

        @media(max-width:800px) {
            .fm {
                grid-template-columns: 1fr
            }
        }

        footer {
            background: linear-gradient(160deg, var(--s9), var(--g9));
            color: #a9bfb7;
            padding: 64px 0 28px;
            font-size: .92rem
        }

        footer .lg {
            color: #fff;
            margin-bottom: 18px
        }

        footer .lg small {
            color: #a9bfb7
        }

        .fgd {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr;
            gap: 48px
        }

        footer h4 {
            color: #fff;
            margin: 0 0 16px
        }

        footer ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            gap: 9px
        }

        footer a {
            text-decoration: none
        }

        footer a:hover {
            color: #fff
        }

        .cr {
            margin-top: 46px;
            padding-top: 22px;
            border-top: 1px solid rgba(255, 255, 255, .12);
            font-size: .85rem
        }

        @media(max-width:800px) {
            .fgd {
                grid-template-columns: 1fr
            }
        }

        .up {
            position: fixed;
            right: 18px;
            bottom: calc(18px + env(safe-area-inset-bottom, 0px));
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: var(--g6);
            color: #fff;
            display: grid;
            place-items: center;
            text-decoration: none;
            z-index: 25;
            opacity: 0;
            pointer-events: none;
            transition: opacity .3s
        }

        .up.v {
            opacity: 1;
            pointer-events: auto
        }

        .rv {
            opacity: 0;
            transform: translateY(34px);
            transition: opacity .8s cubic-bezier(.2, .7, .2, 1), transform .8s cubic-bezier(.2, .7, .2, 1);
            transition-delay: var(--d, 0s)
        }

        .rv.l {
            transform: translateX(-44px)
        }

        .rv.r {
            transform: translateX(44px)
        }

        .rv.in {
            opacity: 1;
            transform: none
        }

        @media(prefers-reduced-motion:reduce) {

            .rv,
            .rise>* {
                opacity: 1;
                transform: none;
                animation: none;
                transition: none
            }

            .alt {
                animation: none
            }

            html {
                scroll-behavior: auto
            }
        }

        :root {
            --hh: clamp(86px, 7.6vw, 140px);
            --px: clamp(16px, 2.4vw, 44px)
        }

        html {
            overflow-x: hidden
        }

        .top {
            background: #020617;
            color: #cfe0da;
            font-size: clamp(12px, .95vw, 16px);
            padding: clamp(8px, .9vw, 16px) 0
        }

        .tw {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            padding: 0 var(--px)
        }

        .tl2,
        .tr2 {
            display: flex;
            gap: clamp(14px, 2.6vw, 48px);
            align-items: center
        }

        .top span {
            display: inline-flex;
            align-items: center;
            gap: 10px
        }

        .ic {
            width: 1.3em;
            height: 1.3em;
            stroke: #10b981;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round
        }

        .hd {
            position: sticky;
            top: 0;
            z-index: 30;
            height: var(--hh);
            margin-bottom: calc(var(--hh)*-1);
            pointer-events: none
        }

        .hw {
            pointer-events: auto;
            height: var(--hh);
            padding: 0 var(--px);
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: height .3s, background .3s, box-shadow .3s
        }

        .hd.s .hw {
            height: 78px;
            background: color-mix(in srgb, var(--pg) 94%, transparent);
            backdrop-filter: blur(12px);
            box-shadow: 0 8px 26px -16px rgba(2, 6, 23, .45)
        }

        .lg {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--tx);
            font-weight: 700;
            font-size: clamp(1.35rem, 2.4vw, 2.6rem);
            line-height: 1
        }

        .lg svg {
            width: clamp(40px, 3.4vw, 66px);
            height: auto;
            flex: none
        }

        .lg small {
            display: block;
            font-size: .36em;
            font-weight: 500;
            margin-top: .4em;
            color: var(--mu)
        }

        footer .lg {
            font-size: 1.4rem
        }

        footer .lg svg {
            width: 38px
        }

        .hr {
            display: flex;
            align-items: center;
            gap: clamp(14px, 2vw, 40px)
        }

        .btn.gs {
            padding: clamp(8px, .7vw, 12px) clamp(8px, .7vw, 12px) clamp(8px, .7vw, 12px) clamp(22px, 2vw, 36px);
            border-radius: clamp(14px, 1.2vw, 22px);
            background: #020617;
            border: 1px solid rgba(16, 185, 129, .35);
            gap: clamp(18px, 2vw, 36px);
            font-size: clamp(.78rem, .95vw, 1.05rem)
        }

        .btn.gs i {
            width: clamp(40px, 3.6vw, 66px);
            height: clamp(40px, 3.6vw, 66px);
            background: linear-gradient(135deg, #10b981, #047857);
            color: #fff;
            border-radius: clamp(10px, .9vw, 16px);
            font-size: 1.4em;
            font-weight: 700
        }

        .ham {
            width: 46px;
            height: 46px;
            border: 0;
            background: none;
            display: grid;
            place-content: center;
            gap: 8px;
            cursor: pointer
        }

        .ham span {
            display: block;
            width: 40px;
            height: 2.5px;
            background: var(--tx);
            border-radius: 2px
        }

        .mn {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            width: min(340px, 86vw);
            background: var(--s9);
            z-index: 40;
            padding: 90px 32px;
            transform: translateX(100%);
            transition: transform .4s;
            display: flex;
            flex-direction: column;
            gap: 18px
        }

        .mn.o {
            transform: none
        }

        .mn a {
            color: #fff;
            text-decoration: none;
            font-size: 1.2rem;
            font-weight: 600
        }

        .mn-x {
            position: absolute;
            top: 20px;
            right: 20px;
            width: 44px;
            height: 44px;
            border: 1px solid rgba(16, 185, 129, .35);
            border-radius: 10px;
            background: rgba(255, 255, 255, .06);
            color: #fff;
            display: grid;
            place-items: center;
            cursor: pointer;
            transition: background .2s, border-color .2s
        }

        .mn-x:hover {
            background: rgba(16, 185, 129, .2);
            border-color: #34d399
        }

        .hero {
            position: relative;
            overflow: hidden;
            min-height: clamp(700px, 56vw, 980px);
            padding: calc(var(--hh) + clamp(30px, 5vw, 100px)) 0 clamp(40px, 4vw, 70px);
            background: radial-gradient(90% 80% at 0% 100%, #8fe3bd 0%, rgba(143, 227, 189, 0) 60%), linear-gradient(165deg, #e8fbf3 0%, #d3f5e5 55%, #c3f0dc 100%)
        }

        @media (prefers-color-scheme:dark) {
            :root:not([data-theme="light"]) .hero {
                background: radial-gradient(90% 80% at 0% 100%, #0e5a43 0%, rgba(14, 90, 67, 0) 60%), linear-gradient(165deg, #07201a, #0a2d24)
            }
        }

        :root[data-theme="dark"] .hero {
            background: radial-gradient(90% 80% at 0% 100%, #0e5a43 0%, rgba(14, 90, 67, 0) 60%), linear-gradient(165deg, #07201a, #0a2d24)
        }

        .vis {
            display: contents
        }

        #c3 {
            position: absolute;
            left: 0;
            bottom: 0;
            width: 46%;
            height: 70%;
            display: block
        }

        #c6 {
            position: absolute;
            right: 0;
            top: calc(var(--hh) + 3%);
            width: 19vw;
            height: min(50%, 36vw);
            display: block
        }

        .hc {
            position: relative;
            z-index: 2;
            margin-left: 45%;
            width: 42%
        }

        .hero .bdg {
            background: transparent;
            border: 1px solid var(--g6);
            color: var(--g7);
            padding: .55em 1.2em;
            border-radius: 12px;
            font-size: clamp(.78rem, .95vw, 1.05rem);
            gap: 12px;
            margin-bottom: clamp(18px, 2vw, 34px)
        }

        .hero .bdg:before {
            display: none
        }

        .hero .bdg:after {
            width: 26px;
