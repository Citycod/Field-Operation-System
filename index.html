<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Field Workforce & Operations Management Platform</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy: #020a3c;
            --navy2: #051a6b;
            --blue: #1d5bf0;
            --pg: #f4f8ff;
            --card: #fff;
            --tx: #0a1640;
            --mu: #4a5a85;
            --ln: #d3def5;
            --sk1: #e6f3ff;
            --sk2: #cfe1ff;
            --f: 'Montserrat', 'Segoe UI', system-ui, sans-serif;
            box-sizing: border-box;
            padding-top: env(safe-area-inset-top, 0px);
            padding-bottom: env(safe-area-inset-bottom, 0px)
        }

        @media (prefers-color-scheme:dark) {
            :root:not([data-theme="light"]) {
                --pg: #050d2b;
                --card: #0b1a4d;
                --tx: #e8eeff;
                --mu: #9fb0e0;
                --ln: #1c2f78;
                --sk1: #0a1a52;
                --sk2: #0b2370
            }
        }

        :root[data-theme="dark"] {
            --pg: #050d2b;
            --card: #0b1a4d;
            --tx: #e8eeff;
            --mu: #9fb0e0;
            --ln: #1c2f78;
            --sk1: #0a1a52;
            --sk2: #0b2370
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 90px
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: var(--pg);
            color: var(--tx);
            font: 500 16px/1.7 var(--f);
            -webkit-font-smoothing: antialiased;
            overflow-x: clip
        }

        h1,
        h2,
        h3 {
            margin: 0;
            line-height: 1.15;
            font-weight: 600;
            letter-spacing: -.01em
        }

        h2 {
            font-size: clamp(1.9rem, 4vw, 3rem)
        }

        p {
            margin: 0
        }

        a {
            color: inherit
        }

        .w {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px
        }

        section {
            padding: 100px 0;
            position: relative
        }

        [data-sc] {
            background-size: cover;
            background-position: center
        }

        .top {
            background: #01072b;
            color: #cfd8ff;
            font-size: 13px;
            padding: 8px 0
        }

        .top .w {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap
        }

        .top a {
            text-decoration: none
        }

        .hd {
            position: sticky;
            top: 0;
            z-index: 30;
            height: 84px;
            margin-bottom: -84px;
            transition: background .3s, backdrop-filter .3s
        }

        .hd.s {
            background: rgba(2, 10, 60, .92);
            backdrop-filter: blur(10px)
        }

        .hd .w {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 84px
        }

        .lg {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.25rem;
            line-height: 1.1
        }

        .lg small {
            display: block;
            font-size: .62rem;
            font-weight: 500;
            opacity: .8;
            letter-spacing: .02em
        }

        .hr {
            display: flex;
            align-items: center;
            gap: 22px
        }

        .hr nav {
            display: flex;
            gap: 26px
        }

        .hr nav a {
            color: #fff;
            text-decoration: none;
            font-size: .9rem;
            opacity: .85
        }

        .hr nav a:hover {
            opacity: 1
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            padding: 6px 6px 6px 22px;
            border-radius: 12px;
            background: var(--blue);
            color: #fff;
            font: 600 .85rem var(--f);
            text-decoration: none;
            border: 0;
            cursor: pointer;
            transition: transform .2s, box-shadow .2s
        }

        .btn i {
            display: grid;
            place-items: center;
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: #fff;
            color: var(--blue);
            font-style: normal;
            transition: transform .25s
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px -10px var(--blue)
        }

        .btn:hover i {
            transform: rotate(45deg)
        }

        .btn.d {
            background: var(--navy);
            border: 1px solid rgba(255, 255, 255, .25)
        }

        .btn.o {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, .5)
        }

        .btn:focus-visible,
        a:focus-visible,
        button:focus-visible {
            outline: 3px solid #7fa4ff;
            outline-offset: 3px
        }

        .ham {
            width: 44px;
            height: 44px;
            border: 0;
            background: none;
            color: #fff;
            cursor: pointer;
            display: grid;
            place-content: center;
            gap: 6px
        }

        .ham span {
            display: block;
            width: 26px;
            height: 2px;
            background: #fff
        }

        .mn {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            width: min(340px, 86vw);
            background: var(--navy);
            z-index: 40;
            padding: 90px 32px;
            transform: translateX(100%);
            transition: transform .4s;
            display: flex;
            flex-direction: column;
            gap: 18px
        }

        .mn.o {
            transform: none
        }

        .mn a {
            color: #fff;
            text-decoration: none;
            font-size: 1.2rem;
            font-weight: 600
        }

        .mn-x {
            position: absolute;
            top: 20px;
            right: 20px;
            width: 44px;
            height: 44px;
            border: 1px solid rgba(255, 255, 255, .2);
            border-radius: 10px;
            background: rgba(255, 255, 255, .08);
            color: #fff;
            font-size: 24px;
            line-height: 1;
            display: grid;
            place-items: center;
            cursor: pointer;
            transition: background .2s, border-color .2s
        }

        .mn-x:hover {
            background: rgba(255, 255, 255, .18);
            border-color: rgba(255, 255, 255, .4)
        }

        @media(max-width:860px) {

            .hr nav,
            .hr .btn {
                display: none
            }
        }

        .bdg {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: var(--navy);
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            padding: 7px 12px;
            border-radius: 7px;
            margin-bottom: 18px;
            border: 1px solid rgba(255, 255, 255, .15)
        }

        .bdg:after {
            content: "";
            width: 16px;
            height: 7px;
            border-radius: 4px;
            background: radial-gradient(circle at 12px 3.5px, #fff 3px, transparent 3.5px), linear-gradient(#fff, #fff) 0 3px/10px 1px no-repeat
        }

        .hero {
            min-height: 100vh;
            min-height: 100svh;
            display: flex;
            align-items: flex-end;
            padding: 140px 0 90px;
            color: #fff;
            overflow: hidden;
            background: var(--navy)
        }

        .sl {
            position: absolute;
            inset: 0;
            opacity: 0;
            transform: scale(1.08);
            transition: opacity 1.2s
        }

        .sl.on {
            opacity: 1;
            animation: kb 8s linear forwards
        }

        @keyframes kb {
            to {
                transform: scale(1)
            }
        }

        .hero:before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(180deg, rgba(2, 10, 60, .6), rgba(2, 10, 60, .2) 40%, rgba(2, 10, 60, .9))
        }

        #c1 {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            opacity: .55
        }

        .hero .w {
            position: relative;
            z-index: 2;
            width: 100%
        }

        .hc {
            max-width: 660px;
            margin-left: 0;
            text-align: left
        }

        .hero h1 {
            font-size: clamp(2.2rem, 5vw, 3.7rem);
            font-weight: 600
        }

        .hero p {
            margin: 24px 0 30px;
            padding-left: 18px;
            border-left: 3px solid var(--blue);
            color: #dbe4ff;
            max-width: 56ch
        }

        .hb {
            display: flex;
            gap: 14px;
            flex-wrap: wrap
        }

        .rise>* {
            opacity: 0;
            transform: translateY(26px);
            animation: ri .9s cubic-bezier(.2, .7, .2, 1) forwards
        }

        .rise>*:nth-child(2) {
            animation-delay: .15s
        }

        .rise>*:nth-child(3) {
            animation-delay: .3s
        }

        .rise>*:nth-child(4) {
            animation-delay: .45s
        }

        @keyframes ri {
            to {
                opacity: 1;
                transform: none
            }
        }

        @media(max-width:860px) {
            .hc {
                margin-left: 0
            }
        }

        .ab {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 72px;
            align-items: center
        }

        .ai {
            position: relative;
            aspect-ratio: 1/1.05
        }

        .ai .m {
            position: absolute;
            right: 0;
            top: 0;
            width: 78%;
            height: 92%;
            border-radius: 22px
        }

        .ai .sm {
            position: absolute;
            left: 0;
            bottom: 0;
            width: 44%;
            aspect-ratio: 1.1;
            border-radius: 16px;
            border: 6px solid var(--pg)
        }

        .rb {
            position: absolute;
            left: 4%;
            top: 12%;
            width: 128px;
            height: 128px;
            border-radius: 50%;
            background: var(--navy);
            display: grid;
            place-items: center;
            z-index: 2;
            box-shadow: 0 14px 34px -10px rgba(2, 10, 60, .6)
        }

        .rb svg {
            position: absolute;
            inset: 0;
            animation: sp 18s linear infinite
        }

        @keyframes sp {
            to {
                transform: rotate(360deg)
            }
        }

        .rb b {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            background: var(--blue);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: 1.3rem
        }

        .ab .bdg {
            background: var(--navy)
        }

        .ab p {
            color: var(--mu);
            margin: 16px 0
        }

        @media(max-width:900px) {
            .ab {
                grid-template-columns: 1fr;
                gap: 40px
            }

            .ai {
                max-width: 520px
            }
        }

        .sky {
            background: linear-gradient(135deg, var(--sk1), var(--sk2))
        }

        .ctr {
            text-align: center
        }

        .ctr h2 {
            max-width: 20ch;
            margin: 0 auto
        }

        .fg {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 50px 40px;
            margin: 64px 0 54px
        }

        .fi {
            text-align: center;
            position: relative;
            padding-top: 44px
        }

        .fi:before {
            content: "";
            position: absolute;
            left: -20px;
            right: -20px;
            top: 11px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--ln) 15%, var(--ln) 85%, transparent)
        }

        .fi:after {
            content: "";
            position: absolute;
            left: 50%;
            top: 0;
            width: 24px;
            height: 24px;
            margin-left: -12px;
            border-radius: 50%;
            background: var(--pg);
            border: 6px solid var(--blue)
        }

        .fi h3 {
            font-size: 1.1rem;
            margin-bottom: 8px
        }

        .fi p {
            color: var(--mu);
            font-size: .95rem;
            max-width: 30ch;
            margin: 0 auto
        }

        @media(max-width:800px) {
            .fg {
                grid-template-columns: 1fr
            }
        }

        .cp {
            background: var(--navy);
            color: #fff;
            overflow-x: clip;
            padding: 0
        }

        .cp-track {
            position: relative;
            min-height: 340vh;
            padding: 24px 0
        }

        .cp-sticky {
            position: sticky;
            top: 84px;
            min-height: calc(100vh - 84px);
            min-height: calc(100svh - 84px);
            display: flex;
            align-items: center;
            padding: 16px 0;
            z-index: 2
        }

        .cp:before {
            content: "";
            position: absolute;
            inset: 0;
            background: var(--navy);
            opacity: .9;
            z-index: 1
        }

        .cp .bg {
            position: absolute;
            inset: 0;
            opacity: .35;
            filter: blur(2px)
        }

        .cp .w {
            position: relative;
            z-index: 2;
            width: 100%
        }

        .cp-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap
        }

        .cp-head .bdg {
            margin-bottom: 10px
        }

        .cp-head h2 {
            font-size: clamp(1.45rem, 2.6vw, 2.05rem);
            line-height: 1.15
        }

        .cp-meta {
            display: flex;
            align-items: center;
            gap: 14px;
            color: #9db8ff;
            font-size: .85rem;
            font-weight: 600
        }

        .cp-prog {
            width: 140px;
            height: 5px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .14);
            overflow: hidden
        }

        .cp-prog i {
            display: block;
            height: 100%;
            width: 14%;
            background: linear-gradient(90deg, #4f86ff, #8ab4ff);
            border-radius: inherit;
            transition: width .12s linear
        }

        .cg {
            display: grid;
            grid-template-columns: .9fr 1.25fr;
            gap: 32px;
            margin-top: 22px;
            align-items: center
        }

        .tl {
            display: flex;
            flex-direction: column;
            gap: 6px
        }

        .tl button {
            position: relative;
            overflow: hidden;
            text-align: left;
            font: 600 .88rem var(--f);
            color: #c7d3ff;
            background: rgba(255, 255, 255, .05);
            border: 1px solid rgba(255, 255, 255, .12);
            padding: 10px 14px;
            border-radius: 10px;
            cursor: pointer;
            transition: background .25s, border-color .25s, box-shadow .25s, color .25s;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            will-change: transform, opacity
        }

        .tl button:after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 2px;
            background: linear-gradient(90deg, #6c9bff, #38bdf8);
            transform-origin: left;
            transform: scaleX(var(--fill, 0));
            opacity: .9
        }

        .tl button:hover {
            background: rgba(255, 255, 255, .1)
        }

        .tl button[aria-selected=true] {
            background: linear-gradient(135deg, rgba(29, 91, 240, .92), rgba(56, 189, 248, .65));
            color: #fff;
            border-color: rgba(127, 164, 255, .85);
            box-shadow: 0 14px 32px -12px rgba(29, 91, 240, .9)
        }

        .pn {
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            min-height: 0;
            height: clamp(290px, 46vh, 380px);
            display: flex;
            align-items: flex-end;
            border: 1px solid rgba(255, 255, 255, .2);
            background: radial-gradient(circle at 60% 30%, rgba(29, 91, 240, .28), rgba(2, 10, 60, .96) 72%);
            transition: background-image .55s ease, box-shadow .35s ease;
            box-shadow: 0 28px 60px -22px rgba(1, 7, 43, .9), 0 0 0 1px rgba(127, 164, 255, .08) inset;
            will-change: transform
        }

        .pn-aura {
            position: absolute;
            width: 340px;
            height: 340px;
            border-radius: 50%;
            top: -90px;
            right: -60px;
            background: radial-gradient(circle, rgba(79, 134, 255, .55), rgba(56, 189, 248, .18) 45%, transparent 72%);
            filter: blur(22px);
            z-index: 1;
            pointer-events: none;
            will-change: transform, opacity
        }

        #c3 {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 2;
            pointer-events: none
        }

        .pn:before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 2;
            background: linear-gradient(180deg, rgba(2, 10, 60, .06) 15%, rgba(2, 10, 60, .94) 84%)
        }

        .pn div.t {
            position: relative;
            z-index: 3;
            width: 100%;
            padding: 24px 26px;
            transition: opacity .32s cubic-bezier(.2, .7, .2, 1), transform .32s cubic-bezier(.2, .7, .2, 1);
            will-change: opacity, transform
        }

        .pn div.t.x {
            opacity: 0;
            transform: translateY(18px) scale(.97)
        }

        .pn-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #8ab4ff;
            margin-bottom: 8px
        }

        .pn-step-bar {
            width: 84px;
            height: 3px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .18);
            overflow: hidden;
            margin-top: 14px
        }

        .pn-step-bar i {
            display: block;
            height: 100%;
            width: 100%;
            background: linear-gradient(90deg, #4f86ff, #34d399);
            transform-origin: left;
            transform: scaleX(.15)
        }

        .pn h3 {
            font-size: 1.25rem;
            line-height: 1.25
        }

        .pn p {
            margin-top: 8px;
            font-size: .92rem;
            line-height: 1.5;
            color: #d7e0ff;
            max-width: 50ch
        }

        @media(max-width:860px) {
            .cp-track {
                min-height: auto;
                padding: 80px 0
            }

            .cp-sticky {
                position: static;
                min-height: auto;
                display: block
            }

            .cg {
                grid-template-columns: 1fr
            }
        }

        .hw {
            background: linear-gradient(160deg, var(--navy), var(--navy2));
            color: #fff;
            overflow: hidden
        }

        #c2 {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%
        }

        .hw .w {
            position: relative;
            z-index: 2
        }

        .st {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 22px;
            margin-top: 58px
        }

        .sc {
            padding: 32px 26px;
            border-radius: 18px;
            background: rgba(255, 255, 255, .07);
            border: 1px solid rgba(255, 255, 255, .16);
            backdrop-filter: blur(8px)
        }

        .sc b {
            display: grid;
            place-items: center;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: var(--blue);
            margin-bottom: 22px;
            font-size: 1.1rem
        }

        .sc p {
            color: #c7d3ff;
            margin-top: 10px;
            font-size: .95rem
        }

        @media(max-width:900px) {
            .st {
                grid-template-columns: 1fr 1fr
            }
        }

        @media(max-width:520px) {
            .st {
                grid-template-columns: 1fr
            }
        }

        .ch {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            margin: 38px 0 22px
        }

        .ch span {
            padding: 11px 22px;
            border-radius: 10px;
            background: var(--card);
            border: 1px solid var(--ln);
            font-weight: 600;
            font-size: .92rem;
            transition: all .2s
        }

        .ch span:hover {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
            transform: translateY(-3px)
        }

        .ctr .ld {
            color: var(--mu);
            max-width: 60ch;
            margin: 0 auto
        }

        .sd {
            position: relative;
            margin-top: 70px;
            display: grid;
            grid-template-columns: 48px 1fr 48px;
            gap: 16px
        }

        .sd>button {
            border: 0;
            background: var(--blue);
            color: #fff;
            border-radius: 14px;
            font: 600 .8rem var(--f);
            writing-mode: vertical-rl;
            cursor: pointer;
            padding: 18px 0;
            transition: background .2s
        }

        .sd>button:first-child {
            transform: rotate(180deg)
        }

        .sd>button:hover {
            background: #0f43c2
        }

        .sv {
            position: relative;
            min-height: 440px;
            border-radius: 24px;
            overflow: hidden
        }

        .sv>article {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: flex-end;
            padding: 42px;
            color: #fff;
            opacity: 0;
            visibility: hidden;
            transition: opacity .6s, visibility .6s;
            text-align: left
        }

        .sv>article.on {
            opacity: 1;
            visibility: visible
        }

        .sv>article:before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(2, 10, 60, 0) 20%, rgba(2, 10, 60, .92))
        }

        .sv>article>div {
            position: relative;
            max-width: 520px
        }

        .sv h3 {
            font-size: clamp(1.5rem, 3vw, 2.2rem)
        }

        .sv p {
            margin: 12px 0 18px;
            color: #d7e0ff
        }

        .sv a {
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .04em;
            text-decoration: none
        }

        @media(max-width:600px) {
            .sd {
                grid-template-columns: 1fr
            }

            .sd>button {
                writing-mode: horizontal-tb;
                padding: 12px
            }

            .sd>button:first-child {
                transform: none;
                order: 2
            }

            .sd>button:last-child {
                order: 3
            }

            .sv {
                order: 1
            }
        }

        .fin {
            background: linear-gradient(160deg, var(--navy2), var(--navy));
            color: #fff;
            text-align: center;
